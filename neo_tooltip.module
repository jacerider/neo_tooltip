<?php

/**
 * @file
 * Primary module hooks for Neo | Tooltip module.
 */

use Drupal\Component\Render\MarkupInterface;
use Drupal\Core\Asset\AttachedAssetsInterface;
use Drupal\Core\Template\Attribute;
use Drupal\neo_tooltip\ElementPreRender;
use Drupal\neo_tooltip\ElementProcess;
use Drupal\neo_tooltip\Tooltip;

/**
 * Implements hook_js_settings_alter().
 */
function neo_tooltip_js_settings_alter(array &$settings, AttachedAssetsInterface $assets) {
  /** @var \Drupal\neo_tooltip\Settings\Settings $config */
  $config = \Drupal::service('neo_tooltip.settings')->getActive();
  $settings['neoTooltip'] = array_diff_key($config->getValues(), ['color' => '']);
  $settings['neoTooltip']['dir'] = \Drupal::moduleHandler()->getModule('neo_tooltip')->getPath();
}

/**
 * Implements hook_preprocess_form_element().
 */
function neo_tooltip_preprocess_form_element(&$variables) {
  if (!empty($variables['element']['#title']) && is_array($variables['element']['#title']) && !empty($variables['element']['#title']['#tooltip'])) {
    // @todo review after automatic tooltipping was added.
    $variables['attributes']['class'][] = 'use-neo-tooltip';
    $variables['attributes']['data-tippy-content'] = $variables['element']['#title']['#tooltip'];
    $variables['#attached']['library'][] = 'neo_tooltip/tooltip';
  }

  // A field whose help moved into a tooltip looks exactly like one with no help
  // at all, and the only way to find it is to hover every field in turn. Hand
  // the label a marker so it can draw a trigger you can actually see.
  //
  // Data only, no markup: which glyph, and how it is sized and coloured, is the
  // theme's business — see form-element-label.html.twig in neo_base.
  if (!empty($variables['element']['#neo_tooltip_help']) && isset($variables['label'])) {
    $title = $variables['element']['#title'] ?? NULL;
    $variables['label']['#neo_tooltip_help'] = [
      'label' => (is_string($title) || $title instanceof MarkupInterface) && trim((string) $title) !== ''
        ? t('More information about @label', ['@label' => $title])
        : t('More information'),
      // Empty because this trigger sits with the control it describes, so it is
      // found by position and needs no id to be matched against. The key is
      // still set, because one template draws every trigger and reads it.
      'target' => '',
    ];
  }
}

/**
 * Implements hook_preprocess_fieldset().
 *
 * A checkboxes or radios group labels itself with a <legend>, which never goes
 * through form_element_label — so the marker planted for a normal field never
 * reached it, and a group was the one field type whose help had no visible
 * trigger. Its own preprocess plants the same thing for fieldset.html.twig.
 */
function neo_tooltip_preprocess_fieldset(&$variables) {
  _neo_tooltip_group_help($variables);
}

/**
 * Implements hook_preprocess_details().
 *
 * Same job as the fieldset hook: a details element names itself with its
 * <summary>, so a control inside it that has no visible label of its own hands
 * its help trigger up here. The two are one pattern with two templates — a
 * style card is a fieldset when it does not collapse and a details when it
 * does, and the help has to survive the switch.
 */
function neo_tooltip_preprocess_details(&$variables) {
  _neo_tooltip_group_help($variables);
}

/**
 * Builds the legend or summary help trigger for a group.
 *
 * @param array $variables
 *   The template variables, by reference.
 *
 * @see \Drupal\neo_tooltip\ElementProcess::placeHelpTrigger()
 */
function _neo_tooltip_group_help(array &$variables): void {
  $help = $variables['element']['#neo_tooltip_help'] ?? NULL;
  $attributes = _neo_tooltip_group_own_description($variables, $help);
  if (empty($help) && $attributes === NULL) {
    return;
  }
  $title = $variables['element']['#title'] ?? NULL;
  $variables['neo_tooltip_help'] = [
    'label' => (is_string($title) || $title instanceof MarkupInterface) && trim((string) $title) !== ''
      ? t('More information about @label', ['@label' => $title])
      : t('More information'),
    // Set when the trigger was handed up by a control inside this group rather
    // than describing the group itself. js/tooltip.ts matches it against the
    // id stamped on that control, which is the only thing tying a badge in the
    // legend to an instance built on a form item further down.
    'target' => is_array($help) ? ($help['target'] ?? '') : '',
    // Set only when this group's own description became the tooltip, in which
    // case the badge is the whole trigger and carries it.
    'attributes' => $attributes,
  ];
}

/**
 * Turns a group's own description into a tooltip, if it has one to turn.
 *
 * A plain fieldset or details is not an input, so ElementProcess never walks it
 * and its description stayed where Drupal put it — printed in full inside the
 * legend, while every field under it had long since moved its help into a
 * badge. On a form built mostly of groups that is most of the help on the page.
 *
 * A group that *is* an input — checkboxes, radios — is already handled by the
 * process callback and arrives here with a marker, so it is left alone.
 *
 * @param array $variables
 *   The template variables, by reference.
 * @param mixed $help
 *   The marker already on the element, if any.
 *
 * @return \Drupal\Core\Template\Attribute|null
 *   Attributes making the badge its own trigger, or NULL when nothing was
 *   converted.
 */
function _neo_tooltip_group_own_description(array &$variables, mixed $help): ?Attribute {
  if (!empty($help) || empty($variables['element']['#description'])) {
    return NULL;
  }
  // Already converted by something else. Without this a group whose badge is
  // switched off would be converted a second time here and open two tooltips
  // carrying the same sentence.
  if (($variables['element']['#description_display'] ?? 'after') === 'invisible') {
    return NULL;
  }
  $description = $variables['element']['#description'];
  if (!is_string($description) && !$description instanceof MarkupInterface) {
    return NULL;
  }
  // With the badge switched off a legend has nothing to hover, so the
  // description stays where it is rather than becoming help nothing can reach.
  if (!ElementProcess::showsHelpIcon() || !ElementProcess::descriptionBecomesTooltip($description)) {
    return NULL;
  }

  $attached = $variables['#attached'] ?? [];
  $tooltip = new Tooltip($description, [
    'delay' => '[300,100]',
    // The description keeps rendering, hidden, and the group's wrapper already
    // points at it — so tippy must not announce it a second time.
    'describedElsewhere' => TRUE,
  ]);
  $attributes = $tooltip->buildAttributes($attached);
  $variables['#attached'] = $attached;

  // Hidden, not dropped: the wrapper points at this with aria-describedby and
  // the reference has to keep resolving. Core hands the two templates their
  // description differently — a fieldset gets an attributes object that can be
  // hidden in place, a details gets a bare string — so the hiding is done once
  // per shape here rather than twice in Twig.
  if (isset($variables['description']['attributes'])) {
    $variables['description']['attributes']->addClass('visually-hidden');
  }
  else {
    $variables['description_display'] = 'invisible';
  }
  return $attributes;
}

/**
 * Implements hook_preprocess_field_multiple_value_form().
 *
 * A multi-value field names itself with a table header, not a label, and its
 * description renders as loose text under the table — close enough to the next
 * field to read as that field's help. It is the one field type left whose help
 * does not look like every other field's.
 *
 * The header cell is what names this control, so the trigger belongs there, and
 * ElementProcess never sees this element to say so: the description sits on a
 * widget wrapper rather than on an input, so no process callback runs over it.
 *
 * Unlike a promoted trigger, this badge carries the tooltip itself. There is no
 * control underneath holding an instance for it to join — `aria-describedby`
 * here points at the table — so the badge is the whole trigger, which is also
 * why it needs no id to be matched against.
 */
function neo_tooltip_preprocess_field_multiple_value_form(&$variables) {
  if (empty($variables['multiple']) || empty($variables['description']['content'])) {
    return;
  }
  $description = $variables['description']['content'];
  if (!is_string($description) && !$description instanceof MarkupInterface) {
    return;
  }
  // With the badge switched off there is nothing to hover — no label, no
  // control of its own — so the description stays visible rather than becoming
  // help nothing can reach.
  if (!ElementProcess::showsHelpIcon() || !ElementProcess::descriptionBecomesTooltip($description)) {
    return;
  }

  $attached = $variables['#attached'] ?? [];
  $tooltip = new Tooltip($description, [
    'delay' => '[300,100]',
    // The description keeps rendering, hidden, and the table already points at
    // it — so tippy must not announce it a second time.
    'describedElsewhere' => TRUE,
  ]);
  $attributes = $tooltip->buildAttributes($attached);
  $variables['#attached'] = $attached;

  $title = $variables['element']['#title'] ?? NULL;
  $variables['neo_tooltip_help'] = [
    'label' => (is_string($title) || $title instanceof MarkupInterface) && trim((string) $title) !== ''
      ? t('More information about @label', ['@label' => $title])
      : t('More information'),
    'target' => '',
    'attributes' => $attributes,
  ];
  // Hidden, not dropped: the table's `aria-describedby` points at this, and the
  // reference has to keep resolving. See ElementProcess::processInput().
  $variables['description']['display'] = 'invisible';
}

/**
 * Implements hook_preprocess_form_element_label().
 */
function neo_tooltip_preprocess_form_element_label(&$variables) {
  // Core's preprocess builds $variables from a handful of keys on the label
  // element and ignores the rest, so the marker planted above has to be lifted
  // out by hand for the template to see it.
  if (!empty($variables['element']['#neo_tooltip_help'])) {
    $variables['neo_tooltip_help'] = $variables['element']['#neo_tooltip_help'];
  }
}

/**
 * Implements hook_element_info_alter().
 */
function neo_tooltip_element_info_alter(array &$info) {
  foreach ($info as &$element) {
    if (isset($element['#process']) && !empty($element['#input'])) {
      $element['#process'][] = [ElementProcess::class, 'processInput'];
    }
  }
  $info['link']['#pre_render'] = array_merge([[ElementPreRender::class, 'link']], $info['link']['#pre_render']);
}

/**
 * Implements hook_library_info_alter().
 */
function neo_tooltip_library_info_alter(&$libraries, $extension) {
  if ($extension == 'core') {
    $libraries['drupal.dropbutton']['js'] = [];
    $libraries['drupal.dropbutton']['css'] = [];
    $libraries['drupal.dropbutton']['dependencies'][] = 'neo_tooltip/dropbutton';
  }
}
